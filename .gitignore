# Что версионируется в стенде: скрипты запуска, код пайплайна, тестовый корпус.
# Что нет: секреты, скачиваемое, состояние процессов.
# Разбор решения — RAG/research/reference/local-stand.md.
#
# ВНИМАНИЕ: в .gitignore комментарий действует только с начала строки.
# "models/  # 1,2 ГБ" — это не правило с пояснением, а имя файла целиком.

# --- Секреты. Никогда. ---
# .env.* закрывает конфиги контуров (.env.partner и будущие): там не только
# ключи, но и адреса чужой инфраструктуры, которым в гите не место.
# .env.example — единственное исключение, он и есть образец без значений.
.env
.env.*
!.env.example
*.key
*.pem

# --- Документы клиентов и всё, что из них выведено. Никогда. ---
# corpus/ версионируется, но там лежат ТОЛЬКО вымышленные документы,
# сгенерированные нами. Всё, что придёт от партнёра или клиента, кладётся
# в каталоги ниже и в гит не попадает физически.
# data/ — сюда же база SQLite: она хранит значения, извлечённые из договоров,
#         и, в отличие от cache/, прогоном не восстанавливается. Держать её
#         рядом с кэшем векторов нельзя: cache/ удаляют не глядя.
corpus-real/
incoming/
data/

# --- Тяжёлое: ставится заново по 08-local-stand.md ---
# models/ — 1,2 ГБ, llama.cpp качает сам по -hf
# bin/    — бинарник Qdrant, 69 МБ
# static/ — дашборд Qdrant, часть дистрибутива, 17 МБ
models/
bin/
static/

# --- Состояние, а не исходники ---
# storage/ — база Qdrant
# cache/   — кэш векторов, пересчитывается за секунды
storage/
snapshots/
logs/
cache/
.qdrant-initialized

# --- Python ---
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv

# --- Редакторы ---
.idea/
.DS_Store
