# Образец конфигурации стенда. Скопировать в .env и заполнить.
#
#   cp .env.example .env && chmod 600 .env
#
# Ключи для локального стенда генерируются любой случайной строкой:
#
#   openssl rand -hex 24
#
# Переезд на инфраструктуру партнёра = правка только этого файла.
# Настоящий .env в гит не попадает — он в .gitignore.

# --- Адреса ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_GRPC_PORT=6334
EMBEDDER_URL=http://127.0.0.1:8080
RERANKER_URL=http://127.0.0.1:8081

# --- Ключи ---
# Локально — любые случайные. У партнёра — выданные им.
QDRANT_API_KEY=
LLAMA_API_KEY=
