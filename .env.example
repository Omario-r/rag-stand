# Образец конфигурации стенда. Скопировать в .env и заполнить.
#
#   cp .env.example .env && chmod 600 .env
#
# Ключи для локального стенда генерируются любой случайной строкой:
#
#   openssl rand -hex 24
#
# Настоящий .env в гит не попадает — он в .gitignore.
#
# КОНТУРЫ. Раньше здесь стояло «переезд на инфраструктуру партнёра = правка
# только этого файла». С 10.08.2026 это не так: контура два и работают они
# одновременно. Этот файл описывает локальный стенд, контур партнёра лежит
# в .env.partner и НАКЛАДЫВАЕТСЯ поверх:
#
#   set -a; source .env; source .env.partner; set +a
#
# Всё .env.* закрыто гитигнором. Разбор — RAG/13-partner-stand.md.

# --- Адреса ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_GRPC_PORT=6334
EMBEDDER_URL=http://127.0.0.1:8080
RERANKER_URL=http://127.0.0.1:8081
LLM_URL=http://127.0.0.1:8084

# --- Ключи ---
# Локально — любые случайные. У партнёра — выданные им.
QDRANT_API_KEY=
LLAMA_API_KEY=
